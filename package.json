{
  "name": "warships-bismarck",
  "version": "1.0.0",
  "description": "Kriegsschiffe: an offline naval combat game of 1939-45. You command warships against AI bots. HTML/JS/Canvas, no build step.",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "test": "node --test tests/ || true",
    "screenshots": "node tests/playwright.shots.mjs",
    "test:3d": "node --test tests/sim3d.test.mjs tests/zoom3d.test.mjs tests/shellcam3d.test.mjs",
    "screenshots:3d": "node tests/playwright3d.shots.mjs"
  },
  "devDependencies": {
    "playwright": "^1.62.1"
  },
  "engines": {
    "node": ">=18"
  }
}
